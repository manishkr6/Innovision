# Web app URL from the Apps Script deployment (see apps-script/README.md).
# Not a secret: it ships in the browser bundle. Without it the form refuses to register.
VITE_REGISTRATION_URL=

# 5-digit check-in PIN for coordinators. Kept here as the record only: the script reads its own copy
# from Script Properties (see apps-script/README.md). Never prefix with VITE_ or it becomes public.
COORDINATOR_PIN=
